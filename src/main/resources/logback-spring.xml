<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- Властивість для назви додатку -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="military-api"/>
    
    <!-- ===== Console Appender (для development) ===== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{correlationId:-NO_CORR}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- ===== JSON Appender (для production) ===== -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>correlationId</includeMdcKeyName>
            <includeMdcKeyName>requestUri</includeMdcKeyName>
            <includeMdcKeyName>requestMethod</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <customFields>{"application":"${appName}"}</customFields>
            <timeZone>UTC</timeZone>
        </encoder>
    </appender>
    
    <!-- ===== File Appender (для архіву) ===== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/military-api.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/military-api.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{correlationId:-NO_CORR}] [%X{userId:-anonymous}] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- ===== Профілі ===== -->
    
    <!-- Development profile - читабельні логи -->
    <springProfile name="default,dev,development">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
        
        <!-- Детальне логування для нашого коду -->
        <logger name="ua.edu.viti.military" level="DEBUG"/>
        
        <!-- SQL логування -->
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.type.descriptor.sql" level="TRACE"/>
    </springProfile>
    
    <!-- Production profile - JSON логи -->
    <springProfile name="prod,production">
        <root level="INFO">
            <appender-ref ref="JSON"/>
            <appender-ref ref="FILE"/>
        </root>
        
        <logger name="ua.edu.viti.military" level="INFO"/>
        
        <!-- Вимкнути verbose логування -->
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.springframework" level="WARN"/>
    </springProfile>
    
    <!-- Test profile -->
    <springProfile name="test">
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
        <logger name="ua.edu.viti.military" level="DEBUG"/>
    </springProfile>
    
</configuration>
